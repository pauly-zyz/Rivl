# Salin ke contracts/.env lalu isi. JANGAN commit file .env (sudah ada di .gitignore).
# Foundry otomatis membaca contracts/.env saat `forge script` dijalankan dari folder contracts/.
#
# Dipakai oleh script/Deploy.s.sol. Lihat README.md bagian "Deploy contract ke testnet".

# ---------------------------------------------------------------------------
# Akun deployer
# ---------------------------------------------------------------------------
# Private key deployer, format 0x… . Lebih aman: jangan simpan di file, ekspor di shell sesaat sebelum deploy:
#   read -s PRIVATE_KEY && export PRIVATE_KEY
# Pakai wallet khusus deploy dengan saldo secukupnya, bukan wallet utama.
PRIVATE_KEY=

# Treasury penerima fee. Produksi: multisig.
TREASURY=
# Owner DuelArena (+ ChainlinkVRFAdapter). Kosong = deployer. Produksi: multisig.
# Jika diisi alamat lain, owner baru harus memanggil acceptOwnership() (Ownable2Step).
OWNER=

# ---------------------------------------------------------------------------
# RPC (dipakai foundry.toml → rpc_endpoints)
# Sumber: https://docs.robinhood.com/chain/connecting/
#   Mainnet chain ID 4663, testnet chain ID 46630.
# ---------------------------------------------------------------------------
ROBINHOOD_TESTNET_RPC=https://rpc.testnet.chain.robinhood.com
ROBINHOOD_RPC=https://rpc.mainnet.chain.robinhood.com

# ---------------------------------------------------------------------------
# USDG (desimal dibaca dari contract token oleh script deploy)
# Sumber: https://docs.paxos.com/guides/stablecoin/usdg/testnet dan /mainnet,
#         https://docs.robinhood.com/chain/contracts/
#   Testnet: 0x7E955252E15c84f5768B83c41a71F9eba181802F
#   Mainnet: 0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
# Kosong = hanya ETH yang diaktifkan.
# ---------------------------------------------------------------------------
USDG=

# ---------------------------------------------------------------------------
# Chainlink VRF v2.5
# Per 22 Okt 2026 Robinhood Chain BELUM ada di https://docs.chain.link/vrf/v2-5/supported-networks
# Kosongkan VRF_COORDINATOR → script memakai DevRandomnessProvider (HANYA testnet; operator
# memilih angka acak, jadi TIDAK provably fair dan tidak boleh di mainnet).
# ---------------------------------------------------------------------------
VRF_COORDINATOR=
VRF_KEY_HASH=
VRF_SUB_ID=
VRF_CONFIRMATIONS=1
# Settle lewat VRF memakai ~116k gas (test ChainlinkVRFAdapter); 300k memberi ruang cukup.
VRF_CALLBACK_GAS=300000
VRF_NATIVE_PAYMENT=true
