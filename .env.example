# Salin ke .env lalu isi. JANGAN commit file .env.
# Jangan mengarang chain ID, RPC, alamat explorer, alamat USDG, atau parameter VRF:
# ambil dari dokumentasi resmi Robinhood Chain / Chainlink dan catat sumbernya.
#
# Untuk development lokal (`pnpm dev`) tidak ada yang wajib diisi.
# Variabel deploy contract (PRIVATE_KEY, TREASURY, OWNER, USDG, VRF_*) ada di contracts/.env.example.

# ---------------------------------------------------------------------------
# Chain (semua paket)
# ---------------------------------------------------------------------------
ROBINHOOD_RPC=
ROBINHOOD_TESTNET_RPC=
# Chain ID resmi (angka). Wajib diisi jika INDEXER_CHAIN=mainnet/testnet.
ROBINHOOD_CHAIN_ID=
ROBINHOOD_TESTNET_CHAIN_ID=

# ---------------------------------------------------------------------------
# Chain lokal (scripts/dev-chain) — Anvil, chain ID 31337
# ---------------------------------------------------------------------------
ANVIL_PORT=8545
# Opsional: alamat tambahan (mis. wallet browser kamu) yang diberi 100 ETH + 10.000 USDG lokal.
# Dipisah koma.
DEV_EXTRA_ACCOUNTS=
# Jeda sebelum auto-fulfill menjawab request randomness (ms), supaya terasa seperti VRF.
AUTO_FULFILL_DELAY_MS=1500

# ---------------------------------------------------------------------------
# Auto-fulfill di testnet (opsional, HANYA dengan DevRandomnessProvider)
# Untuk lokal semua diambil dari deployments/local.json.
# ---------------------------------------------------------------------------
# AUTO_FULFILL_CHAIN=testnet
# DEV_RANDOMNESS_ADDRESS=
# ARENA_ADDRESS dan PRIVATE_KEY (owner DevRandomnessProvider) dipakai bersama.

# ---------------------------------------------------------------------------
# Indexer (Ponder)
# ---------------------------------------------------------------------------
# local | testnet | mainnet
INDEXER_CHAIN=local
INDEXER_PORT=42069
# Untuk testnet/mainnet: alamat DuelArena dan blok deploy-nya.
ARENA_ADDRESS=
ARENA_START_BLOCK=
# Kosong = PGlite (file lokal di indexer/.ponder). Produksi: PostgreSQL.
DATABASE_URL=

# ---------------------------------------------------------------------------
# Web (Tahap 3)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CHAIN_ID=
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_EXPLORER_URL=
NEXT_PUBLIC_ARENA_ADDRESS=
NEXT_PUBLIC_USDG_ADDRESS=
NEXT_PUBLIC_INDEXER_URL=http://localhost:42069
NEXT_PUBLIC_X_URL=
BLOCKED_COUNTRIES=ID,US
