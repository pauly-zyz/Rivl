# Salin ke .env lalu isi. JANGAN commit file .env.
#
# File ini dipakai indexer, web, dan scripts (dibaca dari root repo).
# Variabel deploy contract (PRIVATE_KEY, TREASURY, OWNER, USDG, batas taruhan) ada di contracts/.env.example,
# supaya private key tidak pernah berada di file yang dibaca proses build web.
#
# Untuk development lokal (`pnpm dev`) TIDAK ADA yang wajib diisi: chain lokal, alamat contract,
# dan NEXT_PUBLIC_* diisi otomatis dari deployments/local.json.
#
# Jangan mengarang chain ID, RPC, alamat explorer, atau alamat USDG.
# Nilai di bawah berasal dari dokumentasi resmi (sumber di sebelahnya). Cek ulang sebelum dipakai.
# Ringkasan sumber: docs/technical-status.md

# ===========================================================================
# CHAIN (indexer, scripts, contracts)
# Sumber: https://docs.robinhood.com/chain/connecting/
#   Mainnet  chain ID 4663   explorer https://robinhoodchain.blockscout.com
#   Testnet  chain ID 46630  explorer https://explorer.testnet.chain.robinhood.com
# RPC publik dibatasi rate-nya dan tidak untuk produksi; pakai provider berbayar
# (dokumentasi merekomendasikan Alchemy) untuk indexer dan web produksi.
# ===========================================================================
ROBINHOOD_RPC=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_TESTNET_RPC=https://rpc.testnet.chain.robinhood.com
ROBINHOOD_CHAIN_ID=4663
ROBINHOOD_TESTNET_CHAIN_ID=46630

# ===========================================================================
# CHAIN LOKAL (scripts/dev-chain) — Anvil, chain ID 31337
# ===========================================================================
ANVIL_PORT=8545
# Alamat wallet kamu (dipisah koma) yang diberi 100 ETH + 10.000 USDG lokal saat `pnpm dev`.
# Cara termudah mencoba web dari browser tanpa mengimpor private key apa pun.
DEV_EXTRA_ACCOUNTS=

# ===========================================================================
# INDEXER (Ponder) — indexer/ponder.config.ts
# ===========================================================================
# local | testnet | mainnet
INDEXER_CHAIN=local
INDEXER_PORT=42069
# Testnet/mainnet: alamat DuelArena dan nomor blok deploy-nya (dari hasil `forge script`).
ARENA_ADDRESS=
ARENA_START_BLOCK=
# Kosong = PGlite (file lokal di indexer/.ponder), cukup untuk lokal.
# Produksi: PostgreSQL, mis. postgres://user:pass@host:5432/rivl
DATABASE_URL=
# Wajib untuk `ponder start` (produksi). Pakai nama baru setiap deploy indexer.
# Biarkan dikomentari untuk lokal: nilai kosong bukan sama dengan tidak di-set.
# DATABASE_SCHEMA=rivl_v1

# --- Daily Spin holder RIVL (indexer/src/api/rewards) ---
# Semua kosong = spin tampil "opens when $RIVL launches". Data spin disimpan di schema Postgres "rivl_rewards"
# (terpisah dari tabel Ponder, jadi mengisi variabel ini TIDAK memicu indexing ulang).
# Alamat token RIVL dan blok deploy-nya (isi saat token launch).
RIVL_TOKEN_ADDRESS=
RIVL_TOKEN_START_BLOCK=
# Contract RivlRewards (contracts/script/DeployRewards.s.sol).
REWARDS_ADDRESS=
# Rahasia acak panjang untuk seed harian (mis. `openssl rand -hex 32`). Jangan pernah dibagikan atau diganti
# di tengah hari: hash seed sudah diumumkan sebelumnya.
SPIN_SECRET=

# ===========================================================================
# WEB (Next.js) — web/src/lib/config.ts
# `pnpm dev` mengisi semua NEXT_PUBLIC_* otomatis untuk chain lokal.
# Contoh testnet (sumber: docs.robinhood.com/chain/connecting, docs.paxos.com USDG testnet):
#   NEXT_PUBLIC_CHAIN_ID=46630
#   NEXT_PUBLIC_CHAIN_NAME=Robinhood Chain Testnet
#   NEXT_PUBLIC_RPC_URL=https://rpc.testnet.chain.robinhood.com
#   NEXT_PUBLIC_EXPLORER_URL=https://explorer.testnet.chain.robinhood.com
#   NEXT_PUBLIC_USDG_ADDRESS=0x7E955252E15c84f5768B83c41a71F9eba181802F
# Contoh mainnet:
#   NEXT_PUBLIC_CHAIN_ID=4663
#   NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
#   NEXT_PUBLIC_EXPLORER_URL=https://robinhoodchain.blockscout.com
#   NEXT_PUBLIC_USDG_ADDRESS=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
# ===========================================================================
WEB_PORT=3000
NEXT_PUBLIC_CHAIN_ID=
# Nama jaringan yang tampil di wallet. Default: "Robinhood Chain".
NEXT_PUBLIC_CHAIN_NAME=
# RPC yang dipakai browser (dan ditawarkan ke wallet). Produksi: relay milik web sendiri,
# mis. https://rivl-tau.vercel.app/api/rpc — RPC publik Robinhood tidak selalu bisa dijangkau dari browser
# pemain di semua wilayah. Relay (web/src/app/api/rpc/route.ts) meneruskan ke RPC_UPSTREAM_URL di server.
NEXT_PUBLIC_RPC_URL=
# Hanya server (tidak pernah ke browser): node tujuan relay /api/rpc. Boleh RPC berbayar dengan API key.
RPC_UPSTREAM_URL=
NEXT_PUBLIC_EXPLORER_URL=
NEXT_PUBLIC_ARENA_ADDRESS=
# Desimal USDG dibaca dari contract token saat runtime, tidak perlu diisi.
NEXT_PUBLIC_USDG_ADDRESS=
NEXT_PUBLIC_INDEXER_URL=http://localhost:42069
# Akun X Rivl untuk tombol "Notify me" di kartu Coming Soon. Kosong = tombol nonaktif.
NEXT_PUBLIC_X_URL=
# Opsional. Tanpa ini hanya wallet browser (injected) yang tersedia; MetaMask mobile/WalletConnect butuh project ID
# dari https://cloud.reown.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Geoblock (web/src/proxy.ts). Kode negara ISO dipisah koma. Kosong = semua negara boleh akses (default).
BLOCKED_COUNTRIES=
# Header negara dari hosting/CDN. Kosong = cek header umum (Vercel, Cloudflare, CloudFront, App Engine).
# Produksi: isi dengan header milik hosting kamu (Vercel: x-vercel-ip-country, Cloudflare: cf-ipcountry)
# supaya header palsu dari pengguna tidak dipercaya.
GEO_COUNTRY_HEADER=
