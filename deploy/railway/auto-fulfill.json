{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "deploy/railway/Dockerfile",
    "watchPatterns": ["scripts/**", "contracts/abi/**", "deploy/railway/**", "pnpm-lock.yaml"]
  },
  "deploy": {
    "startCommand": "pnpm --filter @rivl/scripts auto-fulfill",
    "restartPolicyType": "ALWAYS"
  }
}
